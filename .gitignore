/build/
/out/
/screenshots/
/stage/
/dist/
/.icl-infra/
/coverage.json
/site/
CMakeUserPresets.json
.vs/
.vscode/
.idea/
*.user
__pycache__/
*.pyc
.venv/
.cache/
compile_commands.json

# Real configuration files hold confidential values and are never committed.
*-config.json
!config/sample-config.json
# The setup file the app exports and imports (renamed from the same JSON); it holds the same confidential values.
*.ejconfig

# The store graphics, made by tools/store/ for each release.
/store/play/*/images/
# Written by fastlane when it runs (fastlane/Fastfile is the source).
/fastlane/README.md
/fastlane/report.xml
/fastlane/test_output/
# The store screenshots, made by the screenshot tool for each release.
/store/appstore/screenshots/
