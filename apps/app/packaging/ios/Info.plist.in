<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The iOS application's Info.plist. CMake fills the MACOSX_BUNDLE_ names in from the target's properties
     (apps/app/packaging/ios.cmake). CMake substitutes inside comments too, so no comment here may write a dollar sign
     and a brace. -->
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>
    <key>CFBundleIdentifier</key>
    <string>${MACOSX_BUNDLE_GUI_IDENTIFIER}</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>${MACOSX_BUNDLE_BUNDLE_NAME}</string>
    <key>CFBundleDisplayName</key>
    <string>${MACOSX_BUNDLE_BUNDLE_NAME}</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>${MACOSX_BUNDLE_SHORT_VERSION_STRING}</string>
    <!-- The build number. TestFlight refuses a build whose number is not higher than every earlier one for the same
         version, so the release workflow gives the number of its run (ERROR_JOURNALING_IOS_BUILD_NUMBER). -->
    <key>CFBundleVersion</key>
    <string>${MACOSX_BUNDLE_BUNDLE_VERSION}</string>
    <!-- The icon: the AppIcon set in Assets.xcassets, compiled by Xcode (the target's
         ASSETCATALOG_COMPILER_APPICON_NAME names the same set). -->
    <key>CFBundleIconName</key>
    <string>AppIcon</string>
    <!-- The application uses no encryption of its own, and what the system gives it is exempt: without this key
         TestFlight asks about encryption for every build. Change it only if that stops being true. -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
    </array>
    <!-- Dictation (PRD NOTE-07): the microphone and speech recognition, asked for at the first tap on the microphone and
         never at launch. Recognition is on the phone: no audio and no text are sent anywhere. The only usage texts the
         application has; tools/ci/check_ios_plist.py allows no others. -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Field Test listens while you dictate a note. The audio is turned into text on this phone and is not kept or sent anywhere.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>Field Test turns what you say into the text of a note, on this phone. Nothing is sent to Apple or anyone else.</string>
    <key>NSHumanReadableCopyright</key>
    <string>${MACOSX_BUNDLE_COPYRIGHT}</string>

    <!-- The setup file. The application exports one type of its own, with the extension ejconfig, so that it is the only
         thing the phone offers for that file and opens in the application from AirDrop, and registers plain JSON as an
         alternate so that a file that was not renamed still offers the application. The identifier is the bundle identifier plus config and, with the extension and the
         description, is one of the constants in libs/ios_bridge/include/error_journaling/document_types.hpp:
         tools/ci/check_ios_plist.py fails when the two differ. -->
    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.iainchesworthlabs.fieldtest.config</string>
            <key>UTTypeDescription</key>
            <string>Field Test setup</string>
            <!-- Not public.json: the system can show JSON in Quick Look, and an AirDropped file of a type it can show opened
                 as a page of text instead of in the application. public.data and public.content leave nothing to preview.
                 The importer reads the bytes and checks them, so it does not need the JSON type. -->
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.data</string>
                <string>public.content</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>ejconfig</string>
                </array>
            </dict>
        </dict>
    </array>
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Field Test setup</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Owner</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.iainchesworthlabs.fieldtest.config</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>JSON</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.json</string>
            </array>
        </dict>
    </array>
    <!-- The system copies an opened file into the application's sandbox, where the importer owns it and deletes it. The
         application never opens a file in place, and does not turn on file sharing: that would list its Documents folder,
         and the copy of an imported file in it, in Files and Finder. -->
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <false/>

    <!-- No usage text for any permission: the application asks for none. Add the text with the first permission the
         application asks for; the check in packaging/verify_app.sh refuses the keys it lists until then. -->

    <!-- The launch screen, in the property list so that no storyboard is needed: without one iOS runs the program in a legacy
         320 x 480 window and scales it up. Both are in Assets.xcassets. LaunchBackground is the colour of the board's
         background (light and dark), and LaunchBoard is the picture of the Log screen's skeleton, 402 x 874 points at 3x,
         for the iPhone only (an iPad shows the colour alone: no one picture fits both of its orientations and every window
         size), drawn from the application's own QML by tools/launch_image (the tests launch.image_current and
         launch.matches_screen keep it true). The image fills the screen under the status bar and the home indicator, as
         the application's window does, so it ignores the safe area. -->
    <key>UILaunchScreen</key>
    <dict>
        <key>UIColorName</key>
        <string>LaunchBackground</string>
        <key>UIImageName</key>
        <string>LaunchBoard</string>
        <key>UIImageRespectsSafeAreaInsets</key>
        <false/>
    </dict>

    <!-- Orientations. The phone is portrait only: the board is three across and four down in portrait (docs/design). The
         iPad turns to all four, and has no UIRequiresFullScreen, so that the system may run the application in Split View,
         Slide Over and Stage Manager windows (docs/plan/stage-8.md, "Multitasking"). Apple asks for all four orientations
         of an iPad application that is not full screen only (ITMS-90474), and the layout follows the window's size, not
         the device (apps/app/qml/theme/WindowLayout.qml). UIApplicationSupportsMultipleScenes is left out on purpose: the
         application has one window, and two windows would open the same log twice. tools/ci/check_ios_plist.py and
         packaging/ios/verify_app.sh keep these true. -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <!-- ProMotion phones run an application at 60 Hz unless this is true. With it the render loop follows the display,
         up to 120 Hz, and the animations are animators so that they hold the rate (docs/plan/stage-4.md, U7 and 4.14;
         tools/ci/check_ios_plist.py and packaging/ios/verify_app.sh fail without it). -->
    <key>CADisableMinimumFrameDurationOnPhone</key>
    <true/>
</dict>
</plist>
