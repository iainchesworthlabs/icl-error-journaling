<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The iOS application's Info.plist. CMake fills the MACOSX_BUNDLE_ names in from the target's properties
     (apps/app/packaging/ios.cmake). CMake substitutes inside comments too, so no comment here may write a dollar sign
     and a brace. -->
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>
    <key>CFBundleIdentifier</key>
    <string>${MACOSX_BUNDLE_GUI_IDENTIFIER}</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>${MACOSX_BUNDLE_BUNDLE_NAME}</string>
    <key>CFBundleDisplayName</key>
    <string>${MACOSX_BUNDLE_BUNDLE_NAME}</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>${MACOSX_BUNDLE_SHORT_VERSION_STRING}</string>
    <!-- The build number. TestFlight refuses a build whose number is not higher than every earlier one for the same
         version, so the release workflow gives the number of its run (ERROR_JOURNALING_IOS_BUILD_NUMBER). -->
    <key>CFBundleVersion</key>
    <string>${MACOSX_BUNDLE_BUNDLE_VERSION}</string>
    <!-- The icon: the AppIcon set in Assets.xcassets, compiled by Xcode (the target's
         ASSETCATALOG_COMPILER_APPICON_NAME names the same set). -->
    <key>CFBundleIconName</key>
    <string>AppIcon</string>
    <!-- The application uses no encryption of its own, and what the system gives it is exempt: without this key
         TestFlight asks about encryption for every build. Change it only if that stops being true. -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
    </array>
    <key>NSHumanReadableCopyright</key>
    <string>${MACOSX_BUNDLE_COPYRIGHT}</string>

    <!-- The setup file. The application exports one type of its own, with the extension ejconfig, so that it is the only
         thing the phone offers for that file, and registers plain JSON as an alternate so that a file that was not renamed
         still offers the application. The identifier is the bundle identifier plus config and, with the extension and the
         description, is one of the constants in libs/ios_bridge/include/error_journaling/document_types.hpp:
         tools/ci/check_ios_plist.py fails when the two differ. -->
    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.iainchesworthlabs.errorjournaling.config</string>
            <key>UTTypeDescription</key>
            <string>CS Bingo Board setup</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.json</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>ejconfig</string>
                </array>
            </dict>
        </dict>
    </array>
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>CS Bingo Board setup</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Owner</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.iainchesworthlabs.errorjournaling.config</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>JSON</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.json</string>
            </array>
        </dict>
    </array>
    <!-- The system copies an opened file into the application's sandbox, where the importer owns it and deletes it. The
         application never opens a file in place, and does not turn on file sharing: that would list its Documents folder,
         and the copy of an imported file in it, in Files and Finder. -->
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <false/>

    <!-- No usage text for any permission: the application asks for none. Add the text with the first permission the
         application asks for; the check in packaging/verify_app.sh refuses the keys it lists until then. -->

    <!-- A launch screen in the property list: without one iOS runs the program in a legacy 320 x 480 window and scales
         it up. The colour is in Assets.xcassets (LaunchBackground). -->
    <key>UILaunchScreen</key>
    <dict>
        <key>UIColorName</key>
        <string>LaunchBackground</string>
    </dict>

    <!-- Portrait only: the board is three across and four down in portrait (docs/design). The application takes the whole
         screen on an iPad, with no split view or slide over, which is what TestFlight asks of an iPad application that is
         not available in every orientation. -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <key>UIRequiresFullScreen</key>
    <true/>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>

    <!-- ProMotion phones run an application at 60 Hz unless this is true. With it the render loop follows the display,
         up to 120 Hz, and the animations are animators so that they hold the rate (docs/plan/stage-4.md, U7 and 4.14;
         tools/ci/check_ios_plist.py and packaging/ios/verify_app.sh fail without it). -->
    <key>CADisableMinimumFrameDurationOnPhone</key>
    <true/>
</dict>
</plist>
